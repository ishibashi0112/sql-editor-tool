# このファイルを .env にコピーして値を入れてください。.env はコミットされません。

# ===== Oracle =====
ORACLE_USER=
# 空欄のままにすると実行時に入力を求めます（推奨）
ORACLE_PASSWORD=
# 例: host:1521/SERVICE_NAME
ORACLE_CONNECT_STRING=

# ===== SQL Server =====
MSSQL_SERVER=
MSSQL_PORT=1433
# 名前付きインスタンスの場合のみ指定（指定するとPORTは使われません）
MSSQL_INSTANCE=
MSSQL_DATABASE=
MSSQL_USER=
# 空欄のままにすると実行時に入力を求めます（推奨）
MSSQL_PASSWORD=
# Hayamiの実績に合わせて false
MSSQL_ENCRYPT=false
# TLS関連のエラーで接続できない場合のみ TLSv1 などを設定
MSSQL_TLS_MIN_VERSION=

# ===== バインド変数（SQLファイル内の :owner / @schema に対応）=====
# Oracleのスキーマ名（大文字）
BIND_OWNER=
# SQL Serverのスキーマ名
BIND_SCHEMA=dbo
