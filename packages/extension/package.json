{
  "name": "sql-editor-tool",
  "displayName": "SQL Editor Tool（仮称）",
  "description": "社内 DB（SQL Server / Oracle）を、.sql の実行と列見出しのフィルタで見る読み取り専用のツール",
  "version": "0.13.1",
  "private": true,
  "publisher": "ishibashi0112",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/sql-editor-tool.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlEditorTool",
          "title": "SQL Editor Tool",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "sqlEditorToolResults",
          "title": "SQL の結果",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sqlEditorTool": [
        {
          "type": "webview",
          "id": "sqlEditorTool.search",
          "name": "テーブル検索",
          "initialSize": 2
        },
        {
          "id": "sqlEditorTool.connections",
          "name": "接続",
          "initialSize": 1
        },
        {
          "type": "webview",
          "id": "sqlEditorTool.diffCamera",
          "name": "差分カメラ",
          "initialSize": 1
        }
      ],
      "sqlEditorToolResults": [
        {
          "type": "webview",
          "id": "sqlEditorTool.results",
          "name": "SQL の結果"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlEditorTool.connections",
        "contents": "接続がありません。\n[接続を追加](command:sqlEditorTool.addConnection)\n別の PC で書き出した設定があれば、読み込めます。\n[設定を読み込む](command:sqlEditorTool.importSettings)"
      }
    ],
    "commands": [
      {
        "command": "sqlEditorTool.runSql",
        "title": "SQL を実行",
        "category": "SQL Editor Tool",
        "icon": "$(play)"
      },
      {
        "command": "sqlEditorTool.diffCamera.create",
        "title": "差分カメラを作る",
        "category": "SQL Editor Tool",
        "icon": "$(add)"
      },
      {
        "command": "sqlEditorTool.formatSql",
        "title": "SQL を整形（:名前 を分けない）",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.runStatementAt",
        "title": "この文を実行",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.addConnection",
        "title": "接続を追加",
        "category": "SQL Editor Tool",
        "icon": "$(add)"
      },
      {
        "command": "sqlEditorTool.removeConnection",
        "title": "接続を削除",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.disconnect",
        "title": "切断",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.refresh",
        "title": "最新の情報に更新",
        "category": "SQL Editor Tool",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlEditorTool.openTable",
        "title": "データを開く",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.generateSql",
        "title": "SQL を生成…",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.generateSqlHere",
        "title": "テーブルから SQL を生成（カーソルの位置に入れる）…",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.chooseSqlConnection",
        "title": "SQL の補完に使う接続を選ぶ",
        "category": "SQL Editor Tool",
        "icon": "$(database)"
      },
      {
        "command": "sqlEditorTool.toggleLogicalNameHints",
        "title": "SQL の論理名の表示を切り替える（常に／カーソルの行だけ／出さない）",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.exportSettings",
        "title": "設定を書き出す（別の PC へ引き継ぐ）",
        "category": "SQL Editor Tool"
      },
      {
        "command": "sqlEditorTool.importSettings",
        "title": "設定を読み込む（別の PC で書き出したもの）",
        "category": "SQL Editor Tool"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sqlEditorTool.diffCamera.create",
          "when": "view == sqlEditorTool.diffCamera",
          "group": "navigation"
        },
        {
          "command": "sqlEditorTool.addConnection",
          "when": "view == sqlEditorTool.connections",
          "group": "navigation"
        },
        {
          "command": "sqlEditorTool.refresh",
          "when": "view == sqlEditorTool.connections",
          "group": "navigation"
        },
        {
          "command": "sqlEditorTool.exportSettings",
          "when": "view == sqlEditorTool.connections",
          "group": "9_transfer@1"
        },
        {
          "command": "sqlEditorTool.importSettings",
          "when": "view == sqlEditorTool.connections",
          "group": "9_transfer@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlEditorTool.generateSql",
          "when": "view == sqlEditorTool.connections && (viewItem == table || viewItem == view)",
          "group": "navigation@1"
        },
        {
          "command": "sqlEditorTool.disconnect",
          "when": "view == sqlEditorTool.connections && viewItem == connection"
        },
        {
          "command": "sqlEditorTool.removeConnection",
          "when": "view == sqlEditorTool.connections && viewItem == connection"
        }
      ],
      "webview/context": [
        {
          "command": "sqlEditorTool.generateSql",
          "when": "webviewId == 'sqlEditorTool.search' && webviewSection == 'object'"
        }
      ],
      "commandPalette": [
        {
          "command": "sqlEditorTool.removeConnection",
          "when": "false"
        },
        {
          "command": "sqlEditorTool.disconnect",
          "when": "false"
        },
        {
          "command": "sqlEditorTool.openTable",
          "when": "false"
        },
        {
          "command": "sqlEditorTool.chooseSqlConnection",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i"
        },
        {
          "command": "sqlEditorTool.runSql",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i"
        },
        {
          "command": "sqlEditorTool.runStatementAt",
          "when": "false"
        },
        {
          "command": "sqlEditorTool.generateSqlHere",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i"
        }
      ],
      "editor/title": [
        {
          "command": "sqlEditorTool.runSql",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "sqlEditorTool.runSql",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i",
          "group": "navigation@0"
        },
        {
          "command": "sqlEditorTool.formatSql",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i",
          "group": "1_modification@9"
        },
        {
          "command": "sqlEditorTool.generateSqlHere",
          "when": "editorLangId == sql || resourceExtname =~ /^\\.sql$/i",
          "group": "1_modification@10"
        }
      ]
    },
    "configuration": {
      "title": "SQL Editor Tool",
      "properties": {
        "sqlEditorTool.maxRows": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "description": "1 回に取得する行数の上限。超えたときは上限までを表示し、条件の追加を促します。"
        },
        "sqlEditorTool.oracle.clientMode": {
          "type": "string",
          "enum": [
            "thin",
            "thick"
          ],
          "enumDescriptions": [
            "Oracle Client を使わずに接続する（既定）",
            "PC にインストールされている Oracle Client を使って接続する。Thin で接続できないときに使う"
          ],
          "default": "thin",
          "markdownDescription": "Oracle への接続の方式。変更したら、ウィンドウを再読み込みしてください（1 つのウィンドウの中では切り替えられません）。"
        },
        "sqlEditorTool.oracle.clientLibDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "`thick` のときに使う Oracle Client のフォルダ（`oci.dll` のあるフォルダ）。空のときは PATH から探します。"
        },
        "sqlEditorTool.mssql.tlsMinVersion": {
          "type": "string",
          "enum": [
            "",
            "TLSv1",
            "TLSv1.1",
            "TLSv1.2"
          ],
          "enumDescriptions": [
            "既定（TLS 1.2 以上）",
            "TLS 1.0 以上を許す",
            "TLS 1.1 以上を許す",
            "TLS 1.2 以上"
          ],
          "default": "",
          "markdownDescription": "SQL Server へのログインで使う TLS の最低のバージョン。古い SQL Server で TLS のエラーになって接続できないときだけ変更します。"
        },
        "sqlEditorTool.logicalNames.headers": {
          "type": "string",
          "enum": [
            "both",
            "logical",
            "physical"
          ],
          "enumDescriptions": [
            "物理名の下に論理名を出す",
            "論理名を出す（物理名はツールチップ）",
            "物理名だけを出す"
          ],
          "default": "both",
          "markdownDescription": "結果の表の列見出しに出す名前。画面の「列名」の切り替えでも変えられます。"
        },
        "sqlEditorTool.run.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "`.sql` の文ごとに「▶ 実行」を出します（Ctrl+Enter でも実行できます）。"
        },
        "sqlEditorTool.diffCamera.maxRows": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "markdownDescription": "差分カメラで撮る、表ごとの行数の上限。超える表は撮らずに「条件で絞ってください」と出します。"
        },
        "sqlEditorTool.format.keywordCase": {
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "enumDescriptions": [
            "書いたまま",
            "大文字にする",
            "小文字にする"
          ],
          "default": "preserve",
          "markdownDescription": "`.sql` を整形するときの、キーワード（SELECT など）の大文字・小文字。"
        },
        "sqlEditorTool.format.logicalOperatorNewline": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "enumDescriptions": [
            "AND・OR を行の頭に置く",
            "AND・OR を行の終わりに置く"
          ],
          "default": "before",
          "markdownDescription": "`.sql` を整形するときの、AND・OR の位置。"
        },
        "sqlEditorTool.format.expressionWidth": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "`.sql` を整形するときに、括弧の中をこの文字数までなら 1 行にまとめます。"
        },
        "sqlEditorTool.format.linesBetweenQueries": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "`.sql` を整形するときの、`;`・`GO`・`/` で区切った文の間の空行の数。"
        },
        "sqlEditorTool.format.denseOperators": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "`.sql` を整形するときに、演算子（`=`・`+` など）の前後に空白を入れません。"
        },
        "sqlEditorTool.format.newlineBeforeSemicolon": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "`.sql` を整形するときに、`;` の前で改行します。"
        },
        "sqlEditorTool.logicalNames.show": {
          "type": "string",
          "enum": [
            "always",
            "cursorLine",
            "off"
          ],
          "enumDescriptions": [
            "常に出す",
            "カーソルのある行だけに出す",
            "出さない（名前にカーソルを乗せると出る）"
          ],
          "default": "always",
          "markdownDescription": "`.sql` で、テーブル名・列名の後ろに論理名（DB のコメント。SQL Server は拡張プロパティ `MS_Description`、Oracle は `COMMENT ON`）を出すか。コマンド「SQL の論理名の表示を切り替える」でも切り替えられます。"
        },
        "sqlEditorTool.logicalNames.style": {
          "type": "string",
          "enum": [
            "lineEndTag",
            "lineEnd",
            "subtle",
            "bracket",
            "tag",
            "inlayHint"
          ],
          "enumDescriptions": [
            "行の終わりに、列ごとの色の付いた札で並べる（コードの形はそのまま）",
            "行の終わりに、薄い字でまとめる",
            "名前の後ろに、薄い色・斜体・少し小さく",
            "名前の後ろに、薄い色で ‹論理名› と括る",
            "名前の後ろに、色の付いた小さな札",
            "名前の後ろに、VS Code のインレイヒント（0.8.0 の見た目）"
          ],
          "default": "lineEndTag",
          "markdownDescription": "`.sql` の論理名の見た目。色は `workbench.colorCustomizations` の `sqlEditorTool.logicalNameTagForeground`・`sqlEditorTool.logicalNameTagBackground`・`sqlEditorTool.logicalNameForeground` で変えられます。"
        },
        "sqlEditorTool.logicalNames.alignLineEnd": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "論理名を行の終わりに出すとき、空行で区切ったひとかたまりの行ごとに、縦に揃えます。"
        }
      }
    },
    "keybindings": [
      {
        "command": "sqlEditorTool.runSql",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || resourceExtname =~ /^\\.sql$/i)"
      }
    ],
    "colors": [
      {
        "id": "sqlEditorTool.logicalNameForeground",
        "description": ".sql の論理名の文字の色（薄い色・括弧・行末の見た目）",
        "defaults": {
          "dark": "#8b949e",
          "light": "#6e7781",
          "highContrast": "#c0c0c0",
          "highContrastLight": "#4d4d4d"
        }
      },
      {
        "id": "sqlEditorTool.logicalNameTagForeground",
        "description": ".sql の論理名のラベルの文字の色",
        "defaults": {
          "dark": "#9ecbff",
          "light": "#0550ae",
          "highContrast": "#ffffff",
          "highContrastLight": "#0550ae"
        }
      },
      {
        "id": "sqlEditorTool.logicalNameTagBackground",
        "description": ".sql の論理名のラベルの背景の色",
        "defaults": {
          "dark": "#1f6feb33",
          "light": "#0969da14",
          "highContrast": "#1f6feb66",
          "highContrastLight": "#0969da26"
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package:vsix": "node esbuild.mjs --production && vsce package --no-dependencies --skip-license -o ../../releases/"
  },
  "dependencies": {
    "@sql-editor-tool/core": "workspace:*",
    "@sql-editor-tool/driver-mssql": "workspace:*",
    "@sql-editor-tool/driver-oracle": "workspace:*",
    "@sql-editor-tool/host": "workspace:*",
    "@sql-editor-tool/webview": "workspace:*",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
